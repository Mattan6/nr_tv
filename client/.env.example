# Leave VITE_API_URL unset. When unset, client/src/services/api.js asks for a relative
# '/api' — the same origin the page itself came from. In production one Express process
# serves both the page and the API; in development Vite forwards /api to port 5000 (see
# vite.config.js). Either way it works from the TV, from a phone on the shul's WiFi, and
# from a phone anywhere on the internet over HTTPS.
#
# Set it ONLY if the API genuinely runs on a different host from the web page. Setting it
# to http://localhost:5000 breaks every device except the server itself — on the gabbai's
# phone "localhost" resolves to the phone, not the server.
# VITE_API_URL=https://api.example.com
VITE_HEBCAL_API_URL=https://www.hebcal.com
VITE_SEFARIA_API_URL=https://www.sefaria.org/api

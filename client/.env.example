# Leave VITE_API_URL unset. When unset, client/src/services/api.js defaults to
# `${window.location.hostname}:5000` — the host the page itself was loaded from, which
# is correct whether you're on the server machine, the gabbai's phone, or the TV. Only
# set VITE_API_URL if the API genuinely runs on a DIFFERENT machine from the web page.
# Setting it to http://localhost:5000 breaks every device except the server itself —
# on the gabbai's phone "localhost" resolves to the phone, not the server.
# VITE_API_URL=http://localhost:5000
VITE_HEBCAL_API_URL=https://www.hebcal.com
VITE_SEFARIA_API_URL=https://www.sefaria.org/api
